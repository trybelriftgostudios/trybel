# ==========================================
# Trybel Campus Platform Environment Config
# ==========================================

# 1. Server Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=trybel-super-secure-jwt-college-secret-key-2026

# 2. PostgreSQL Database Connection
# Accepts connection string from Supabase, Neon, Railway, AWS RDS, or local PostgreSQL:
# e.g.: postgresql://postgres:your_password@ep-sample-1234.us-east-2.aws.neon.tech/trybel_db?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trybel_db

# 3. Cloudinary Media & Asset Storage (v2)
# Get these from your Cloudinary Console dashboard (https://console.cloudinary.com/)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional: Media signing key for expiring photo URLs
MEDIA_SECRET=trybel-secure-media-signing-key-2026
